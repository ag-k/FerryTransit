{
  "name": "nuxt-app",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "TMPDIR=/tmp PORTLESS_PORT=1355 PORTLESS_HTTPS=1 portless",
    "dev:local": "TMPDIR=/tmp npm run dev:setup && TMPDIR=/tmp nuxt dev --dotenv .env.local",
    "ai:opencode:commit": "opencode --prompt \"変更点をコミットしてください\"",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:full": "concurrently -k --kill-others-on-fail --kill-signal SIGINT --names \"emulators,portless\" \"npm run firebase:emulators:with-data\" \"npm run dev\"",
    "dev:full:local": "concurrently -k --kill-others-on-fail --kill-signal SIGINT --names \"emulators,nuxt\" \"npm run firebase:emulators:with-data\" \"npm run dev:local\"",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --run",
    "test:api": "vitest run src/test/unit/api/",
    "test:api:watch": "vitest src/test/unit/api/",
    "test:integration": "vitest run src/test/integration/",
    "test:integration:watch": "vitest src/test/integration/",
    "test:helpers": "vitest run src/test/unit/api/helpers.test.ts",
    "test:all": "vitest run src/test/unit/api/ src/test/integration/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:appstore-screenshots": "APPSTORE_STATIC_ROOT=.output/public APPSTORE_SCREENSHOT_DIR=output/appstore-screenshots/ios-6.7-ja playwright test -c playwright.appstore.config.ts src/tests/e2e/appstore-screenshots.spec.ts --workers=1",
    "lint": "eslint src",
    "typecheck": "nuxt typecheck",
    "firebase:emulators": "firebase emulators:start",
    "firebase:emulators:with-admin": "node scripts/start-emulators-with-admin.mjs",
    "firebase:emulators:with-data": "node scripts/start-emulators-with-data.mjs",
    "firebase:emulators:export": "node scripts/export-emulator-data.mjs",
    "firebase:deploy": "firebase deploy --project prod",
    "firebase:deploy:hosting": "firebase use prod && firebase deploy --only hosting",
    "firebase:deploy:functions": "firebase deploy --only functions --project prod",
    "deploy": "run-s build-prod deploy:only",
    "deploy:only": "firebase deploy --project prod",
    "deploy:only:dev": "firebase deploy --project dev",
    "fetch:routes": "node scripts/fetch-routes.mjs",
    "fetch:routes:online": "node scripts/fetch-online-routes.mjs",
    "cap:ios": "node scripts/cap-build.mjs ios --open",
    "cap:android": "node scripts/cap-build.mjs android --open",
    "cap:ios:build": "node scripts/cap-build.mjs ios",
    "cap:android:build": "node scripts/cap-build.mjs android",
    "cap:ios:appstore-screenshots": "node scripts/capture-ios-simulator-screenshots.mjs",
    "build-prod": "run-s build-prod:firebase build-prod:build",
    "build-prod:firebase": "firebase use prod",
    "build-prod:build": "NODE_ENV=production nuxt generate --dotenv .env.production",
    "build-dev": "run-s build-dev:firebase build-dev:build",
    "build-dev:firebase": "firebase use dev",
    "build-dev:build": "NODE_ENV=development nuxt generate --dotenv .env.development",
    "deploy-prod": "run-s build-prod deploy:only",
    "deploy-prod:hosting": "run-s build-prod:build firebase:deploy:hosting",
    "deploy-dev": "run-s build-dev deploy:only:dev",
    "build-app-dev": "cp .env.development .env && CAPACITOR_BUILD=true npm run generate && npx cap copy",
    "functions:deploy:script": "bash scripts/deploy-functions.sh",
    "gtfs:validate": "node scripts/gtfs/validate.mjs",
    "gtfs:build": "node scripts/gtfs/build-public-data.mjs",
    "gtfs:convert:ama:r8": "node scripts/gtfs/convert-ama-r8-pdf.mjs",
    "gtfs:convert:nishinoshima:2026": "node scripts/gtfs/convert-nishinoshima-2026-pdf.mjs",
    "gtfs:convert:chibu:2023": "node scripts/gtfs/convert-chibu-2023-image.mjs",
    "gtfs:convert:okinoshima:2026": "node scripts/gtfs/convert-okinoshima-2026.mjs",
    "gtfs:convert:ichibata:2026": "node scripts/gtfs/convert-ichibata-bus-connection-2026.mjs"
  },
  "portless": {
    "name": "ferry-transit",
    "script": "dev:local"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.6",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.6",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.6",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@googlemaps/js-api-loader": "^1.16.10",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@nuxt/icon": "^1.15.0",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/i18n": "^9.5.6",
    "@pinia/nuxt": "^0.11.3",
    "@types/google.maps": "^3.65.1",
    "@types/marked": "^5.0.2",
    "@types/papaparse": "^5.5.2",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dayjs": "^1.11.21",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "marked": "^16.4.2",
    "nuxt": "^4.4.8",
    "papaparse": "^5.5.3",
    "pinia": "^3.0.4",
    "vue": "3.5.35",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.6",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@nuxtjs/tailwindcss": "^7.0.0-beta.0",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.60.0",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.10.2",
    "npm-run-all": "^4.1.5",
    "portless": "^0.12.0",
    "postcss": "^8.5.15",
    "sass": "^1.100.0",
    "sass-loader": "^16.0.8",
    "tailwindcss": "^4.3.0",
    "unstorage": "^1.17.5",
    "vite": "^7.3.5",
    "vitest": "^4.1.7",
    "vue-tsc": "3.3.3"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-darwin-arm64": "0.102.0",
    "@oxc-parser/binding-darwin-x64": "0.102.0"
  },
  "overrides": {
    "@google-cloud/storage": "^7.19.0",
    "@isaacs/brace-expansion": "^5.0.1",
    "@xmldom/xmldom": "^0.8.13",
    "@tootallnate/once": "^3.0.1",
    "defu": "^6.1.6",
    "diff": "^8.0.3",
    "lodash": "4.18.1",
    "minimatch": "^10.2.1",
    "nanotar": "^0.3.0",
    "google-gax": "^5.0.6",
    "http-proxy-agent": "^9.0.0",
    "protobufjs": "^7.6.4",
    "qs": "^6.14.2",
    "fast-xml-parser": "^5.7.1",
    "retry-request": "^8.0.2",
    "shell-quote": "1.8.4",
    "teeny-request": "^10.1.2",
    "uuid": "^14.0.0"
  }
}
